# KARA-OKEY Environment Variables
# Local dev needs ZERO keys: live karaoke search scrapes YouTube directly
# (curated songs are instant; live results follow in ~1-2s).

# Optional: YouTube Data API v3 Key — only used as a backup if the keyless
# live search is ever blocked. Get one free: Google Cloud Console → YouTube Data API v3.
YOUTUBE_API_KEY=

# Optional: Pusher Channels (for scaling beyond 1 serverless instance on Vercel)
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: Upstash Redis (for persistent queue state across Vercel serverless functions)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
